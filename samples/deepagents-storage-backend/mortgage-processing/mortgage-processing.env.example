# Set this for Azure Storage, or use AZURE_STORAGE_CONNECTION_STRING for Azurite.
AZURE_STORAGE_ACCOUNT_URL=
# AZURE_STORAGE_CONNECTION_STRING=

# Configure your preferred model provider. No credential belongs in this template.
MODEL_NAME=
AZURE_AI_PROJECT_ENDPOINT=

# Mortgage Blob routes. These defaults may be changed for your account.
MORTGAGE_PACKET_ID=MORT-2026-0042
AZURE_STORAGE_MORTGAGE_SOURCE_CONTAINER=mortgage-packets
# Optional; defaults to MORTGAGE_PACKET_ID.
# AZURE_STORAGE_MORTGAGE_SOURCE_PREFIX=incoming/MORT-2026-0042
AZURE_STORAGE_MORTGAGE_GUIDANCE_CONTAINER=mortgage-agent-context
AZURE_STORAGE_MORTGAGE_OUTPUT_CONTAINER=mortgage-decisions
# Optional; defaults to MORTGAGE_PACKET_ID.
# AZURE_STORAGE_MORTGAGE_OUTPUT_PREFIX=decisions/MORT-2026-0042
MORTGAGE_DEMO_TIMEOUT_SECONDS=180
