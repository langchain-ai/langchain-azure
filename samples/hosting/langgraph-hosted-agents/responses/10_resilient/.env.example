# Values required for every deployment.
AZURE_SUBSCRIPTION_ID="<subscription-id>"
AZURE_LOCATION="<foundry-project-region>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1-mini"

# Existing Foundry project only. Uncomment both lines when skipping `azd provision`.
# FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
# AZURE_AI_PROJECT_ID="/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>"

# Connect Application Insights to the Foundry project before deploying.
# For local tracing, uncomment and copy that resource's connection string.
# Foundry injects this value when the agent is hosted.
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=...;IngestionEndpoint=..."
