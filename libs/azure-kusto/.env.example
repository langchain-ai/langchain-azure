# Copy to `.env` and fill in your database. The integration tests skip
# themselves when these are unset. Authentication is DefaultAzureCredential --
# `az login` is enough, and no credential belongs in here.

# Query URI of an Azure Data Explorer cluster or a Fabric Eventhouse.
KUSTO_CLUSTER_URI=https://<cluster>.<region>.kusto.windows.net
# A database with at least one table. The identity needs the Viewer role.
KUSTO_DATABASE=<database>
