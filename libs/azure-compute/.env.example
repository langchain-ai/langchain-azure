# Copy to `.env` and fill in the resources you have. Each integration suite
# skips itself when its variables are unset, so a partial file runs a partial
# suite. Authentication is DefaultAzureCredential -- `az login` is enough, and
# no credential belongs in here.

# tests/integration_tests/dynamic_sessions/test_end_to_end.py
# A Python-typed session pool.
AZURE_DYNAMIC_SESSIONS_POOL_MANAGEMENT_ENDPOINT=https://<region>.dynamicsessions.io/subscriptions/<subscription-id>/resourceGroups/<resource-group>/sessionPools/<pool-name>
